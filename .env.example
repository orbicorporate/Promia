# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# chave publicável (sb_publishable_...), pode ir pro navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chave secreta (sb_secret_...), só no servidor; nunca com prefixo NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic (busca de foto e gerente inteligente)
ANTHROPIC_API_KEY=
# só se a chave não for de um workspace (Console > Settings > Workspaces, id wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
